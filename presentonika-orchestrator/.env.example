PORT=8080
REDIS_URL=redis://localhost:6379
QUEUE_NAME=presentonika_jobs
WORKER_CONCURRENCY=2
LOG_LEVEL=info
WP_UPLOAD_TIMEOUT_MS=20000
WP_FAIL_ON_UPLOAD_ERROR=true
WP_UPLOAD_ENABLED=true
ENABLE_MOCK_WP=false
PUBLIC_ZIP_BASE_URL=http://localhost:8080
STAGED_DIR=.staged
STAGED_TTL_SECONDS=1800
STAGED_ENABLE_SERVER=true
WP_SAVE_MODE=from_url
WP_SAVE_FROM_URL_TIMEOUT_MS=30000
STAGED_CLEANUP_ON_SUCCESS=true
STAGED_CLEANUP_DELAY_SECONDS=0

BACKGROUND_GEN_TIMEOUT_MS=60000
ARTIFACT_TTL_SECONDS=21600
CLEANUP_INTERVAL_SECONDS=600
MOCK_WP_TTL_SECONDS=21600
MAX_SLIDES=30
MAX_TEMPLATE_ZIP_BYTES=200000000
MAX_OUTZIP_BYTES_LOCAL=250000000
MAX_STAGED_BYTES=250000000
ENABLE_CLEANUP=true
