NODE_ENV=production
PORT=8080
REDIS_URL=redis://redis:6379
QUEUE_NAME=presentonika_jobs
WORKER_CONCURRENCY=2
LOG_LEVEL=info
PRESENTONIKA_ORCHESTRATOR_KEY=strong-secret-token
ORCHESTRATOR_PUBLIC_KEY=change-me-long-random-string
JOBS_RATE_LIMIT_MAX=30
JOBS_RATE_LIMIT_WINDOW_SECONDS=300

THEMES_DIR=themes
ENABLE_MOCK_WP=false
STAGED_ENABLE_SERVER=true
ENABLE_CLEANUP=true

PUBLIC_ZIP_BASE_URL=https://editor.presentonika.ru
WP_SAVE_MODE=from_url
WP_SAVE_FROM_URL_TIMEOUT_MS=30000
WP_SAVE_WAIT_TIMEOUT_MS=5000
WP_SAVE_RETRY_BASE_DELAY_MS=400
WP_SAVE_RETRIES=10
WP_FAIL_ON_UPLOAD_ERROR=true
WP_UPLOAD_ENABLED=true
WP_UPLOAD_TIMEOUT_MS=20000

STAGED_DIR=.staged
STAGED_TTL_SECONDS=1800
STAGED_CLEANUP_ON_SUCCESS=true
STAGED_CLEANUP_DELAY_SECONDS=0

BACKGROUND_GEN_TIMEOUT_MS=60000
ARTIFACT_TTL_SECONDS=21600
CLEANUP_INTERVAL_SECONDS=600
MOCK_WP_TTL_SECONDS=21600
MAX_SLIDES=30
MAX_TEMPLATE_ZIP_BYTES=200000000
MAX_OUTZIP_BYTES_LOCAL=250000000
MAX_STAGED_BYTES=250000000

# RAG toggle
RAG_ENABLED=false
RAG_FAIL_ON_ERROR=false

# RAG endpoint + auth
RAG_BASE_URL=http://localhost:8000
RAG_API_KEY=
RAG_COLLECTION=default

# retrieval params
RAG_MODE=retrieve
RAG_TOP_K=10
RAG_MIN_SCORE=0.45

# timeouts/retries
RAG_TIMEOUT_MS=15000
RAG_MAX_RETRIES=2
RAG_RETRY_BASE_DELAY_MS=400

# context limits (to keep LLM prompt stable)
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_HITS=12

# optional default source uri allowlist (CSV). If empty => allow all sources in collection.
RAG_DEFAULT_SOURCE_URIS=

# include rag.json in out.zip when available
RAG_INCLUDE_IN_OUTZIP=true

# LLM (DeepSeek)
LLM_ENABLED=true
LLM_FAIL_ON_ERROR=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_JSON_REPAIR_RETRIES=2
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=1800
LLM_MAX_OUTPUT_CHARS=50000
