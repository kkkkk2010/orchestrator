{
  "name": "presentonika-orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "npm run typecheck && tsc -p tsconfig.json",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "theme:inspect": "tsx src/tools/themeInspect.ts",
    "theme:validate": "tsx src/tools/themeValidate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "start:prod": "concurrently \"npm:start\" \"npm:start:worker\"",
    "test": "tsx src/tests/run.ts",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "template:qa": "tsx src/tools/templateQa.ts",
    "template:patch": "tsx src/tools/templatePatch.ts",
    "template:generate": "tsx src/tools/templateGenerate.ts",
    "tools:build": "tsc -p tsconfig.json",
    "template:generate:node": "npm run tools:build && node dist/tools/templateGenerate.js",
    "layout:validate": "tsx src/layouts/validate.ts",
    "layout:inspect": "tsx src/layouts/inspect.ts",
    "layout:import": "tsx src/layouts/importLayout.ts",
    "layout:validate:node": "npm run tools:build && node dist/layouts/validate.js",
    "layout:inspect:node": "npm run tools:build && node dist/layouts/inspect.js",
    "layout:import:node": "npm run tools:build && node dist/layouts/importLayout.js"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.0",
    "bullmq": "^5.12.7",
    "dotenv": "^16.4.5",
    "fastify": "5.10.0",
    "ioredis": "^5.4.1",
    "openai": "^4.57.0",
    "pino": "^9.3.2",
    "pngjs": "^7.0.0",
    "yauzl": "^2.10.0",
    "yazl": "^3.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/pngjs": "^6.0.5",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
